\@writefile{lof}{\contentsline {figure}{\numberline {5}{\ignorespaces Data-quality analysis. (a)~$186$ near-duplicate pairs ($10$ cross-class) form $124$ clusters covering $36\%$ of BUSI, including an exact cross-class duplicate. (b)~Simulated random $70/30$ splits leak dozens of clusters across train/test (mean on the order of tens of clusters), motivating a cluster-grouped split. Panel~(b) shows one $40$-run simulation.}}{8}{figure.caption.11}\protected@file@percent }
\newlabel{fig:quality}{{5}{8}{Data-quality analysis. (a)~$186$ near-duplicate pairs ($10$ cross-class) form $124$ clusters covering $36\%$ of BUSI, including an exact cross-class duplicate. (b)~Simulated random $70/30$ splits leak dozens of clusters across train/test (mean on the order of tens of clusters), motivating a cluster-grouped split. Panel~(b) shows one $40$-run simulation}{figure.caption.11}{}}
